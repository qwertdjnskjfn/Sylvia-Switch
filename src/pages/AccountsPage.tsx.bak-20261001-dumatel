                                  <Pencil className="size-3.5" />
                                </Button>
                              </TooltipTrigger>
                              <TooltipContent side="top">编辑备注</TooltipContent>
                            </Tooltip>
                            {isPool && (
                              <Tooltip>
                                <TooltipTrigger asChild>
                                  <Button
                                    size="sm"
                                    variant="ghost"
                                    className="h-7 px-1.5 text-xs"
                                    onClick={() => setUnifiedProxyEdit({ id: acc.id, value: acc.proxy ?? "" })}
