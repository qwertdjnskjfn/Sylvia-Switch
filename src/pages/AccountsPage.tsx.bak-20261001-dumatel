                                    <ExternalLink className="size-3.5" />
                                  </Button>
                                </TooltipTrigger>
                                <TooltipContent side="top">打开 {platformLabel(acc.platform)} 渠道页</TooltipContent>
                              </Tooltip>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          </Card>
        </section>
