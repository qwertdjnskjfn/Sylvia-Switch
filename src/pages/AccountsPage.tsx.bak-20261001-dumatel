                                    <Globe className="size-3.5" />
                                  </Button>
                                </TooltipTrigger>
                                <TooltipContent side="top">编辑出站代理（一号一 IP）</TooltipContent>
                              </Tooltip>
                            )}
                            {isPool && (
                              <Tooltip>
                                <TooltipTrigger asChild>
                                  <Button
                                    size="sm"
                                    variant="ghost"
                                    className="h-7 px-1.5 text-xs text-destructive hover:text-destructive"
