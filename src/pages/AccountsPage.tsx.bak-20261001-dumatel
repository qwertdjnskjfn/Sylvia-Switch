                                </Button>
                              </TooltipTrigger>
                              <TooltipContent side="top">刷新状态与积分</TooltipContent>
                            </Tooltip>
                            <Tooltip>
                              <TooltipTrigger asChild>
                                <Button
                                  size="sm"
                                  variant="ghost"
                                  className="h-7 px-1.5 text-xs"
                                  onClick={() => openUnifiedNote(acc)}
                                  aria-label={`编辑 ${displayName} 备注`}
