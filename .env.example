# wb-switch 环境变量示例
#
# 本项目默认**无需任何环境变量**即可运行：首次启动会在 ~/.wb-switch/ 自动生成配置。
# 以下是代码中实际读取的可选环境变量，复制为 .env 后按需启用（.env 不会进版本库）。
# 注意：部分变量是排障/实验用途，默认不设置。

# ── DuMate 渠道 ──────────────────────────────────────────────
# 自定义 OpenCode 上游地址（默认使用本机 OpenCode 实例）
# DUMATE_OPENCODE_URL=http://127.0.0.1:4097
# 关闭注入「无 Agent 时不直接回答」的提示词约束
# DUMATE_NO_AGENT_DIRECTIVE=1
# 请求体守卫：超过该比例的异常膨胀请求直接拒绝（0 表示关闭）
# DUMATE_PAYLOAD_GUARD=1
# DUMATE_PAYLOAD_GUARD_RATIO=0.5

# ── Loomy 渠道 ───────────────────────────────────────────────
# 置 off 可关闭「思考节制」提示词注入（复杂推理任务建议关闭）
# LOOMY_BRIEF_THINKING=off

# ── MiniMax 账号池清理（维护脚本用）─────────────────────────
# 只做演练不真删
# MINIMAX_SWEEP_DRY_RUN=1
# 包含已禁用账号
# MINIMAX_SWEEP_INCLUDE_DISABLED=1
# 跳过当日已领取的账号
# MINIMAX_SWEEP_SKIP_CLAIMED=1
